# Non-secret settings of a production host (docs/operations/install.md). `make prod-secrets` copies this file to .env.
# Secrets never go here; they live in files under .secrets/.
PADDOCK_ENV=production
PADDOCK_LOG_LEVEL=info

# Public hostnames: admin., auth., device., bundles. and fleet. below this domain, each with a DNS record pointing at
# the control-plane host. Caddy obtains their certificates from a public ACME CA (HTTP-01 on port 80).
PADDOCK_DOMAIN=paddock.example.org
PADDOCK_ACME_EMAIL=ops@example.org
PADDOCK_HTTPS_PORT=443
PADDOCK_PUBLIC_ADMIN_URL=https://admin.paddock.example.org
PADDOCK_PUBLIC_DEVICE_URL=https://device.paddock.example.org
# Addresses that may open the portal and the admin API (space-separated CIDRs); default every address.
# PADDOCK_ADMIN_ALLOWED_CIDRS=203.0.113.0/24 10.0.0.0/8

# Private interconnect between the two hosts (VPN or private network, never the internet). PADDOCK_INTERCONNECT_ADDR
# is this host's own address on it; only the TLS endpoints the other host needs are published there.
PADDOCK_INTERCONNECT_ADDR=10.10.0.1
PADDOCK_CONTROLPLANE_ADDR=10.10.0.1
PADDOCK_AUDIT_ADDR=10.10.0.2

# Images built by `make image image-compiler` or pulled from your registry (tag + digest).
# PADDOCK_IMAGE=registry.example.org/paddock-server:1.0.0
# PADDOCK_COMPILER_IMAGE=registry.example.org/paddock-compiler:1.0.0

# Audit retention in days (minimum: the bucket default of 400 days).
PADDOCK_AUDIT_RETENTION_DAYS=400

# Lock and Destroy stay off until the hardware acceptance protocol and the second-person review have passed
# (docs/operations/revocation-acceptance.md). Then set both.
PADDOCK_REVOCATION_ENABLED=false
PADDOCK_REVOCATION_ACCEPTED=no
