# Non-secret settings for the Compose stack. `make dev-secrets` copies this file to .env.
# Secrets never go here; they live in files under .secrets/ (development) or your secret store (production).

# development enables the development-only shortcuts (stored OpenBao unseal shares, dev users without MFA).
# Production deployments MUST set production.
PADDOCK_ENV=development
PADDOCK_LOG_LEVEL=info

# Public hostnames are admin.<domain>, auth.<domain>, device.<domain> and bundles.<domain>. *.localhost resolves to 127.0.0.1 without DNS setup.
PADDOCK_DOMAIN=paddock.localhost
# Host port Caddy listens on (inside and outside the container, so containers can use the browser URLs).
PADDOCK_HTTPS_PORT=8443
PADDOCK_PUBLIC_ADMIN_URL=https://admin.paddock.localhost:8443
# Device API URL written into enrollment configurations (device.<domain>).
PADDOCK_PUBLIC_DEVICE_URL=https://device.paddock.localhost:8443

# Audit retention in days (minimum: the bucket default of 400 days).
PADDOCK_AUDIT_RETENTION_DAYS=400

# Device logins (device authorizations) Authentik accepts per client address, as <count>/<second|minute|hour|day>;
# devices behind one NAT address share it (docs/operations/device-login.md). Default 600/hour (development: 1000/hour).
# PADDOCK_DEVICE_LOGIN_THROTTLE=600/hour
