# Non-secret settings of a lab host (docs/operations/lab-install.md, ADR 0029): one host behind your own TLS proxy.
# NOT FOR PRODUCTION. Secrets never go here; they live in files under .secrets/.
PADDOCK_ENV=production
PADDOCK_LOG_LEVEL=info
# The lab profile: control plane and audit domain in one Compose project on this host.
PADDOCK_HOST=lab
# Compose project name (prefix of the containers, volumes and networks); keep it across upgrades.
# PADDOCK_PROJECT=paddock

# Public hostnames: admin., auth., device., bundles. and fleet. below this domain. All five resolve to your proxy,
# from the devices and from this host. Your proxy holds a publicly trusted certificate for all five.
PADDOCK_DOMAIN=paddock.example.org
PADDOCK_PUBLIC_ADMIN_URL=https://admin.paddock.example.org
PADDOCK_PUBLIC_DEVICE_URL=https://device.paddock.example.org

# This host's LAN address: Caddy's plain-HTTP port binds here and nothing else is published.
PADDOCK_INTERCONNECT_ADDR=192.0.2.10
PADDOCK_LAB_HTTP_PORT=8080
# The proxy's address as this host reaches it: the Paddock roles resolve the five names to it, and the certificate
# probe dials it on 443.
PADDOCK_LAB_PROXY_ADDR=192.0.2.5
# The proxy's address as Caddy sees it (the same address, unless the proxy runs on this host: see the guide). Only
# this peer may name the client through X-Forwarded-For; never private_ranges, never a /0.
PADDOCK_EDGE_TRUSTED_PROXIES=192.0.2.5
PADDOCK_EDGE_CLIENT_IP_HEADER=X-Forwarded-For
# Addresses that may open the portal, the admin API and Authentik's administrative paths: your LAN; never a /0.
PADDOCK_ADMIN_ALLOWED_CIDRS=192.0.2.0/24
# The Paddock roles reach Authentik's API through the proxy; the proxy sees them as this host. Never private_ranges.
PADDOCK_INTERNAL_CIDRS=192.0.2.10/32
# The fixed subnet of network edge, its dynamic pool and Caddy's address outside the pool; change all three together,
# only on a collision (./paddock check warns).
# PADDOCK_EDGE_SUBNET=172.28.0.0/24
# PADDOCK_EDGE_IP_RANGE=172.28.0.128/25
# PADDOCK_EDGE_CADDY_ADDRESS=172.28.0.10
# Peers of the Paddock roles whose X-Paddock-Client-IP (set by Caddy) names the client: Caddy's address alone (default).
# PADDOCK_TRUSTED_PROXY_CIDRS=172.28.0.10/32
# Break-glass only: the api ignores the application IP allow list while true; ./paddock check fails until removed.
# PADDOCK_IP_ALLOWLIST_BYPASS=false
# Application rate limits per minute (docs/operations/install.md, NAT sizing); 0 is refused by prod-check.
# PADDOCK_RATELIMIT_AUTH=20
# PADDOCK_RATELIMIT_ADMIN_READ=600
# PADDOCK_RATELIMIT_ADMIN_WRITE=120
# PADDOCK_RATELIMIT_PLATFORM_UPLOAD=10
# PADDOCK_RATELIMIT_BUNDLES_APT=60
# PADDOCK_DEVICE_PER_IP_LIMIT=300
# PADDOCK_DEVICE_PER_IP_V6_PREFIX=64

# Backups are optional in the lab: yes adds compose.backup.yaml (the local repository and the backup role; targets
# and the backup key are set up in the portal). With no, nothing is backed up.
PADDOCK_LAB_BACKUP=no

# Audit retention in days (minimum: the bucket default of 400 days; the lab does not relax it).
PADDOCK_AUDIT_RETENTION_DAYS=400
# Audit index retention in days (minimum: PADDOCK_AUDIT_RETENTION_DAYS; required, the worker does not start without
# it). The audit writer drops older monthly index partitions; the worker's retention round deletes the control-plane
# rows that explain audit events no earlier than the index drops their month, so both read this one variable.
PADDOCK_AUDIT_INDEX_RETENTION_DAYS=400

# Largest evidence export in bytes (default 4 GiB): the limit of the decoded events.jsonl, which the audit writer
# spools on its volume audit-writer-tmp, and of the whole package; a larger export fails with reason
# export_too_large (docs/operations/audit-bucket.md section 4).
# PADDOCK_AUDIT_EXPORT_MAX_BYTES=4294967296

# Web worker processes of Authentik: simultaneous logins share them, each one CPU core and about 250 MiB RAM
# (docs/operations/capacity.md, "Authentik web workers"). Default 4; raise it with the cores of a larger host.
# PADDOCK_AUTHENTIK_WEB_WORKERS=4

# Memory limits of the databases, the broker, Fleet and Prometheus (docs/operations/capacity.md, "Memory limits"):
# a container that reaches its limit is restarted. Raise a limit for a larger installation; the defaults are shown.
# PADDOCK_POSTGRES_MEM_LIMIT=2g
# PADDOCK_AUTHENTIK_POSTGRES_MEM_LIMIT=1g
# PADDOCK_AUDIT_POSTGRES_MEM_LIMIT=1g
# PADDOCK_VALKEY_MEM_LIMIT=512m
# PADDOCK_FLEET_REDIS_MEM_LIMIT=512m
# PADDOCK_FLEET_MYSQL_MEM_LIMIT=2g
# Whole number with an optional unit (1536m, not 1.5g): RabbitMQ ignores anything else and sizes its alarm from host RAM.
# PADDOCK_RABBITMQ_MEM_LIMIT=1g
# PADDOCK_FLEET_MEM_LIMIT=3g
# PADDOCK_PROMETHEUS_MEM_LIMIT=1g

# Agent release import from GitHub (ADR 0043, docs/operations/agent-releases.md "Import from GitHub"): the repository
# whose signed releases a platform administrator may import ("off" switches the import off, e.g. air-gapped
# installations) and the API base (a GitHub Enterprise Server uses https://<host>/api/v3; https only).
# PADDOCK_AGENT_RELEASE_SOURCE_REPO=phischl/paddock-mdm
# PADDOCK_AGENT_RELEASE_SOURCE_URL=https://api.github.com
# Optional token with read access to the releases (raises GitHub's limit of 60 requests per hour); it needs a Compose
# override that sets this variable on paddock-api and adds the secret (see the document above).
# PADDOCK_AGENT_RELEASE_SOURCE_TOKEN_FILE=/run/secrets/agent_release_source_token
# Outbound proxy of the api; NO_PROXY must then list the stack's internal hosts (see the document above).
# HTTPS_PROXY=http://proxy.example.org:3128
# HTTP_PROXY=http://proxy.example.org:3128
# NO_PROXY=localhost,127.0.0.1,openbao,rustfs,valkey,escrow-reader,caddy,.paddock.example.org

# Security notifications by e-mail (docs/operations/install.md, "E-mail relay"): the SMTP relay of paddock-notifier. Without a
# host, organizations can use webhook destinations only. TLS is required: starttls (default, port 587) or implicit
# (port 465). The relay's password goes into .secrets/smtp_password, only with a username. PADDOCK_SMTP_ENABLED tells
# the api that a relay exists; keep it true exactly when PADDOCK_SMTP_HOST is set (./paddock check fails otherwise).
# A relay with a certificate of a private CA needs a Compose override that mounts the CA on paddock-notifier and sets
# PADDOCK_SMTP_CA_FILE there.
PADDOCK_SMTP_ENABLED=false
# PADDOCK_SMTP_HOST=smtp.example.org
# PADDOCK_SMTP_PORT=587
# PADDOCK_SMTP_TLS=starttls
# PADDOCK_SMTP_USERNAME=paddock
# PADDOCK_SMTP_FROM=paddock@example.org

# Lock and Destroy stay off until the hardware acceptance protocol and the second-person review have passed.
PADDOCK_REVOCATION_ENABLED=false
PADDOCK_REVOCATION_ACCEPTED=no

# Base directory of the portal's local backup targets (plan M15 decision 36): a local target is a relative subpath of it,
# and ./paddock backup-target apply mounts nothing outside it. Create it owned by root and not writable by group or
# others; ./paddock check verifies it.
PADDOCK_BACKUP_LOCAL_ROOT=/srv/paddock-backup

# Automatic unseal of OpenBao (ADR 0035, docs/operations/openbao.md section 6): set by
# ./paddock auto-unseal enable|disable after a platform administrator acknowledged the disclaimer in the portal;
# do not edit by hand.
PADDOCK_AUTO_UNSEAL=no
