PADDOCK_ENV=production
# The host of this .env: controlplane or audit.
PADDOCK_HOST=controlplane
PADDOCK_DOMAIN=paddock.example.org
# The new mail relay of the notifier.
# It must accept TLS.
PADDOCK_SMTP_HOST=smtp.example.org
# Optional tuning, has a default.
PADDOCK_LOG_LEVEL=info
# PADDOCK_AUTO_UNSEAL=no
