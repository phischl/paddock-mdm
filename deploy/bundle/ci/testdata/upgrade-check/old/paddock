#!/usr/bin/env bash
# Fixture stand-in for the old bundle's ./paddock: verify as the real one does; ps and compose answer from the
# environment of the test.
cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1
case "${1:-}" in
  verify) sha256sum -c --quiet SHA256SUMS && echo "all shipped files unchanged" ;;
  ps) printf '%s\n' "${FIXTURE_PS-$(printf 'paddock-api|running|healthy|0\npostgres|running|healthy|0')}" ;;
  compose) printf '%s\n' "$*" >>"${FIXTURE_COMPOSE_LOG:-/dev/null}"; printf '%s\n' "${FIXTURE_REPORT:-}"; exit "${FIXTURE_REPORT_EXIT:-0}" ;;
esac
