#!/usr/bin/env bash
# Entry point of the operator bundle (plan M7b decision 16, ADR 0022): every operation of a production host, with the
# Compose files of PADDOCK_HOST and the project PADDOCK_PROJECT of .env. Never prints a secret.
set -euo pipefail

BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat >&2 <<'EOF'
usage: ./paddock <command> [arguments]
  version                         print the bundle version
  verify                          check the shipped files against SHA256SUMS
  secrets                         generate this host's secrets into .secrets/ (idempotent)
  pull [service...]               pull every image of this host that is not present locally (services: always)
  check [--online]                production checklist (prod-check) of this host's configuration
  up [--infra]                    start the stack and wait until healthy (--infra: infrastructure only)
  down [--volumes]                stop the stack (--volumes also deletes the data)
  ps                              list the services
  logs [service...]               show the last log lines
  compose <args...>               docker compose with this host's files
  bao <args...>                   the bao CLI inside the openbao container (BAO_TOKEN from the environment)
  bootstrap openbao|buckets|audit-bucket|fleet
                                  configure OpenBao, the buckets or Fleet (docs/operations/install.md)
  agent-release <version> <dir>   upload and publish signed agent artifacts (control plane)
  agent-rollout <version> [--waves 1,10,50,100] [--min-wave-minutes N] [--failure-threshold-percent P]
                [--failure-threshold-min M]
                                  start the staged rollout of a published release (control plane)
  agent-rollout-halt <version>    halt the running rollout of a release (control plane)
  agent-rollout-resume <version>  resume the halted rollout of a release (control plane)
  auto-unseal status|enable|disable
                                  automatic unseal of OpenBao on this host (docs/operations/openbao.md section 6)
  restore --plan <id> | --from <path> | --from-target-file <file> [--at <time>] [--only <component>]...
          [--keep-key-file]       restore the control plane from a backup set (./paddock restore --help)
  backup-target apply             mount the local, SMB and NFS backup targets saved in the portal (control plane, lab
                                  with backups); then ./paddock up
  backup-target export <name|id> <file>
                                  write an S3 backup target with its credentials to a 0600 file, for a restore
                                  without a database (keep it offline with the backup key)
  backup now [--kind k]... [--label l] [--wait]
                                  request a backup run of every kind or the named ones; --wait follows it
  backup status                   the backup key, the newest runs and the targets
  migrate-from <old dir>          take over .env and .secrets/ of the bundle directory of the running version
  upgrade-check <old dir> [--json]
                                  read-only check of what an upgrade from the running version needs (changes nothing)
  upgrade <old dir> [--yes] [--allow-unsupported-agents] [--skip-backup]
                                  upgrade from the running version: the check, migrate-from, secrets, pull, check, the
                                  labelled pre-upgrade backup, up, post-checks; a second run continues a failed one
  rollback <old dir> [--yes]      back to the version of <old dir>: down, the restore of the pre-upgrade backup when the
                                  schema changed, up in <old dir> (every change since the upgrade is lost then)
EOF
  exit 2
}

die() {
  echo "paddock: $1" >&2
  exit "${2:-1}"
}

cmd="${1:-}"
(($#)) && shift
case "$cmd" in
  version)
    cat "$BUNDLE_DIR/VERSION"
    exit 0
    ;;
  verify)
    cd "$BUNDLE_DIR"
    sha256sum -c --quiet SHA256SUMS
    echo "all shipped files unchanged"
    exit 0
    ;;
  migrate-from)
    old="${1:-}"
    [[ $# -eq 1 && -d "$old" ]] || die "usage: ./paddock migrate-from <old bundle directory>" 2
    old="$(cd "$old" && pwd)"
    [[ "$old" != "$BUNDLE_DIR" ]] || die "migrate-from: <old dir> is this directory" 2
    [[ ! -e "$BUNDLE_DIR/.env" ]] || die "migrate-from: .env exists here; refusing to overwrite it"
    [[ ! -e "$BUNDLE_DIR/.secrets" ]] || die "migrate-from: .secrets/ exists here; refusing to overwrite it"
    # The rendered backup targets hold the SMB passwords: they move with cp -a (mode 0600, owner) instead of a new
    # render, which would decrypt them again; without the file the new stack runs paddock-backup without its volumes.
    targets=compose.backup-targets.yaml
    [[ ! -e "$BUNDLE_DIR/$targets" && ! -L "$BUNDLE_DIR/$targets" ]] ||
      die "migrate-from: $targets exists here; refusing to overwrite it"
    [[ -f "$old/.env" && -d "$old/.secrets" ]] || die "migrate-from: $old has no .env and .secrets/"
    if [[ -L "$old/$targets" ]] || [[ -e "$old/$targets" && ! -f "$old/$targets" ]]; then
      die "migrate-from: $old/$targets is not a regular file"
    fi
    # The targets file goes first, to a temp name: a failed copy (disk full, a source the caller cannot read) leaves
    # nothing behind, neither a truncated overlay nor the .env that would refuse the next run (PDK-733 review 3).
    tmp=
    if [[ -f "$old/$targets" ]]; then
      tmp="$(mktemp "$BUNDLE_DIR/.$targets.XXXXXX")"
      trap 'rm -f "$tmp"' EXIT
      cp -a "$old/$targets" "$tmp" || die "migrate-from: could not copy $old/$targets; nothing changed"
    fi
    cp -a "$old/.env" "$BUNDLE_DIR/.env"
    cp -a "$old/.secrets" "$BUNDLE_DIR/.secrets"
    if [[ -n "$tmp" ]]; then
      mv -T "$tmp" "$BUNDLE_DIR/$targets"
      echo "copied .env, .secrets/ and $targets from $old"
    else
      echo "copied .env and .secrets/ from $old"
    fi
    exit 0
    ;;
  upgrade-check)
    # shellcheck source=../compose/scripts/upgrade-check.sh
    . "$BUNDLE_DIR/scripts/upgrade-check.sh"
    status=0
    upgrade_check "$BUNDLE_DIR" "$@" || status=$?
    exit "$status"
    ;;
  upgrade)
    # Before the .env check: this directory gets its .env from the old one during the upgrade (migrate-from).
    # shellcheck source=../compose/scripts/upgrade-check.sh
    . "$BUNDLE_DIR/scripts/upgrade-check.sh"
    # shellcheck source=../compose/scripts/upgrade.sh
    . "$BUNDLE_DIR/scripts/upgrade.sh"
    # shellcheck source=../compose/scripts/legacy-alpha8.sh
    . "$BUNDLE_DIR/scripts/legacy-alpha8.sh"
    upgrade_main "$BUNDLE_DIR" "$@"
    exit 0
    ;;
  secrets | pull | check | up | down | ps | logs | compose | bao | bootstrap | agent-release | agent-rollout | agent-rollout-halt | agent-rollout-resume | auto-unseal | restore | backup-target | backup | rollback) ;;
  *) usage ;;
esac

# dotenv <name>: the value in .env only; the process environment does not count for the host settings.
dotenv() { grep "^$1=" "$BUNDLE_DIR/.env" | tail -1 | cut -d= -f2- || true; }
[[ -f "$BUNDLE_DIR/.env" ]] || die "missing .env: cp .env.example .env (a lab host: cp .env.lab.example .env), then set PADDOCK_HOST and the settings of this host" 2
[[ "$(dotenv PADDOCK_ENV)" == production ]] || die "PADDOCK_ENV in .env must be production (the bundle is for production hosts)" 2
PADDOCK_HOST="$(dotenv PADDOCK_HOST)"
[[ "$PADDOCK_HOST" == controlplane || "$PADDOCK_HOST" == audit || "$PADDOCK_HOST" == lab ]] ||
  die "set PADDOCK_HOST to controlplane, audit or lab in .env (is '${PADDOCK_HOST}')" 2
PADDOCK_ENV=production
export PADDOCK_ENV PADDOCK_HOST

# shellcheck source=../compose/scripts/lib.sh
. "$BUNDLE_DIR/scripts/lib.sh"

# tty_flag prints -T unless stdin and stdout are terminals, so that piped and redirected output stays plain.
tty_flag() { [[ -t 0 && -t 1 ]] || printf -- '-T'; }

# require_host <host> lab <command>: the command runs on that host, or on a lab host, which holds both (ADR 0029).
require_host() {
  [[ "$PADDOCK_HOST" == "$1" || "$PADDOCK_HOST" == "$2" ]] || die "$3 runs on the $1 host (PADDOCK_HOST is $PADDOCK_HOST)" 2
}

# set_dotenv <name> <value>: replaces the line name=… of .env, or appends it; keeps the file's mode.
set_dotenv() {
  local name="$1" value="$2" env="$BUNDLE_DIR/.env" tmp
  tmp="$(mktemp "$BUNDLE_DIR/.env.XXXXXX")"
  if grep -q "^${name}=" "$env"; then
    sed "s|^${name}=.*|${name}=${value}|" "$env" >"$tmp"
  else
    cat "$env" >"$tmp"
    [[ -z "$(tail -c 1 "$env")" ]] || echo >>"$tmp"
    printf '%s=%s\n' "$name" "$value" >>"$tmp"
  fi
  chmod --reference="$env" "$tmp"
  mv "$tmp" "$env"
}

# lab_warning prints the lab profile's warning as the command's first output line.
lab_warning() {
  [[ "$PADDOCK_HOST" != lab ]] ||
    echo "lab profile (PADDOCK_HOST=lab): not for production — see docs/operations/lab-install.md" >&2
}

# require_backup_host <command>: the command runs where the backup role runs (control plane, lab with backups).
require_backup_host() {
  backup_host || die "$1 runs on the control plane or on a lab host with PADDOCK_LAB_BACKUP=yes (PADDOCK_HOST is $PADDOCK_HOST)" 2
}

# backup_role <args…>: paddock-server in a one-off paddock-backup container, without the rendered target volumes: the
# database commands need none, and an unreachable share must not block the emergency path.
backup_role() {
  BACKUP_TARGETS_OVERLAY='' compose --profile paddock run --rm --no-deps "$@"
}

# resolve_local_targets <file>: every local device the rendered file names must still be a real directory below
# PADDOCK_BACKUP_LOCAL_ROOT (plan M15 decision 36), checked by paddock-server in a container without network or
# capabilities that sees the root's parent read-only, as ./paddock check does. The kernel resolves a bind mount on
# every container start, hence the check before every up and not only at apply.
resolve_local_targets() {
  local root line devs=() mounts=() m
  root="$(dotenv PADDOCK_BACKUP_LOCAL_ROOT)"
  while IFS= read -r line; do
    devs+=("$(base64 -d <<<"${line#\# local: }")") || return 1
  done < <(grep '^# local: ' "$1")
  ((${#devs[@]})) || return 0
  while IFS= read -r m; do mounts+=("$m"); done < <(backup_root_mount "$root")
  docker run --rm --user 0:0 --network none --cap-drop ALL --read-only "${mounts[@]}" "$PADDOCK_IMAGE" \
    backup resolve-local ${root:+--root "$root"} -- "${devs[@]}" </dev/null >/dev/null
}

case "$cmd" in
  secrets)
    exec "$BUNDLE_DIR/scripts/gen-prod-secrets.sh" "$PADDOCK_HOST"
    ;;
  pull)
    if (($#)); then
      compose --profile '*' pull "$@"
      exit
    fi
    # An image already present by its reference (tag and digest) is not pulled again: a host that loaded the images
    # with `docker load` (offline) and the CI upgrade job's locally built candidate pass the pull (decisions-alpha9
    # item 54). An image whose reference names a digest is identified by it, so a present one is the shipped one.
    refs="$(compose --profile '*' config --images)" || die "cannot read the images of this host's Compose files"
    while IFS= read -r ref; do
      [[ -n "$ref" ]] || continue
      if docker image inspect "$ref" >/dev/null 2>&1; then
        echo "present: $ref"
      else
        docker pull "$ref" || die "pulling $ref failed"
      fi
    done < <(sort -u <<<"$refs")
    ;;
  check)
    online=
    case "${1:-}" in
      "") ;;
      --online) online=1 ;;
      *) die "usage: ./paddock check [--online]" 2 ;;
    esac
    lab_warning
    # The check reads the production configuration exactly as shipped: no extra Compose files (the CI overlay), and
    # not the rendered backup targets, whose volume options hold the SMB passwords (decisions-alpha9 item 35).
    export BACKUP_TARGETS_OVERLAY=''
    files="$(PADDOCK_COMPOSE_EXTRA='' compose_files)"
    names="$(xargs -n1 basename <<<"$files" | paste -sd, -)"
    # The configuration names host paths (secret files, mounted files), hence the bundle directory at its own path;
    # root, because .secrets/ is the operator's 0700 directory and the image's default user is 65532.
    # The backup root's parent too (read-only), so that the check sees the root itself and not a path inside the image.
    mounts=()
    while IFS= read -r m; do mounts+=("$m"); done < <(backup_root_mount "$(dotenv PADDOCK_BACKUP_LOCAL_ROOT)")
    # Online, the audit bucket is read over audit-store (audit, lab), and on a host with backups the rendered targets'
    # revisions are compared with the database's (plan M15 decision 22): the header line only, never the file.
    network=() revisions=()
    if [[ -n "$online" && "$PADDOCK_HOST" != controlplane ]]; then network=(--network "${PADDOCK_PROJECT}_audit-store"); fi
    if [[ -n "$online" ]] && backup_host; then
      rev_file=none
      [[ ! -f "$BACKUP_TARGETS_FILE" ]] || rev_file="$(sed -n 's/^# revisions: //p' "$BACKUP_TARGETS_FILE" | head -1)"
      rev_db="$(backup_role -T paddock-backup admin backup-targets revisions </dev/null 2>/dev/null | tail -1)" || rev_db=""
      [[ "$rev_db" =~ ^(none|[0-9a-f=\ -]+)$ ]] || rev_db=""
      revisions=(--backup-revisions-file "${rev_file:-none}" --backup-revisions-db "$rev_db")
    fi
    PADDOCK_COMPOSE_EXTRA='' compose --profile '*' config --format json |
      docker run --rm -i --user 0:0 "${network[@]}" "${mounts[@]}" \
        -v "$BUNDLE_DIR:$BUNDLE_DIR:ro" -w "$BUNDLE_DIR" "$PADDOCK_IMAGE" \
        prod-check --host "$PADDOCK_HOST" --compose-files "$names" ${online:+--online} "${revisions[@]}"
    ;;
  up)
    profiles=(--profile paddock --profile observability)
    case "${1:-}" in
      "") ;;
      --infra) profiles=() ;;
      *) die "usage: ./paddock up [--infra]" 2 ;;
    esac
    lab_warning
    if [[ "$PADDOCK_HOST" != audit && "$(uname -m)" != x86_64 ]]; then
      die "the control plane needs an amd64 host: the Fleet image (fleetdm/fleet) is published for linux/amd64 only"
    fi
    if backup_host && [[ -f "$BACKUP_TARGETS_FILE" ]]; then
      resolve_local_targets "$BACKUP_TARGETS_FILE" ||
        die "a local backup target no longer resolves below PADDOCK_BACKUP_LOCAL_ROOT (see above); fix the directory or the target, then ./paddock backup-target apply"
    fi
    run_redacted compose "${profiles[@]}" up -d
    "$BUNDLE_DIR/scripts/wait-healthy.sh" "${profiles[@]}"
    ;;
  down)
    case "${1:-}" in
      "") compose --profile paddock --profile observability down ;;
      --volumes) compose --profile paddock --profile observability down -v ;;
      *) die "usage: ./paddock down [--volumes]" 2 ;;
    esac
    ;;
  ps)
    compose --profile '*' ps "$@"
    ;;
  logs)
    compose --profile '*' logs --no-color --tail 300 "$@" | redact_tokens
    ;;
  compose)
    # The rendered backup targets hold the SMB passwords in their volume options. Compose folds a long option line onto
    # continuation lines, which no line-based redaction catches, so its configuration (config, alias convert) is not
    # printed at all while the overlay is in the file set; mount errors stay redacted (PDK-733 review 3).
    if [[ " $* " == *" config "* || " $* " == *" convert "* ]]; then
      files="$(compose_files)" || exit 2
      if [[ $'\n'"$files"$'\n' == *$'\n'"${BACKUP_TARGETS_OVERLAY-$BACKUP_TARGETS_FILE}"$'\n'* ]]; then
        die "compose config: refusing to print the configuration: compose.backup-targets.yaml holds the SMB passwords of the backup targets and Compose would print them; read the shipped compose files instead"
      fi
    fi
    run_redacted compose "$@"
    ;;
  bao)
    # shellcheck disable=SC2046
    compose exec $(tty_flag) -e BAO_ADDR=https://127.0.0.1:8200 -e BAO_CACERT=/run/secrets/internal_ca_bundle \
      ${BAO_TOKEN:+-e BAO_TOKEN} openbao bao "$@"
    ;;
  bootstrap)
    case "${1:-}" in
      openbao)
        require_host controlplane lab "bootstrap openbao"
        "$BUNDLE_DIR/scripts/openbao-configure.sh"
        ;;
      buckets)
        require_host controlplane lab "bootstrap buckets"
        "$BUNDLE_DIR/scripts/rustfs-bundles-bootstrap.sh"
        ;;
      audit-bucket)
        require_host audit lab "bootstrap audit-bucket"
        "$BUNDLE_DIR/scripts/rustfs-audit-bootstrap.sh"
        ;;
      fleet)
        require_host controlplane lab "bootstrap fleet"
        "$BUNDLE_DIR/scripts/fleet-bootstrap.sh"
        ;;
      *) die "usage: ./paddock bootstrap openbao|buckets|audit-bucket|fleet" 2 ;;
    esac
    ;;
  agent-release)
    [[ $# -eq 2 && -d "$2" ]] || die "usage: ./paddock agent-release <version> <dir>" 2
    require_host controlplane lab "agent-release"
    release_dir="$(cd "$2" && pwd)"
    # paddock-api runs as uid 65532 and reads the directory through a read-only bind mount (plan M8x decision 50).
    unreadable="$(find "$release_dir" \( -type d ! -perm -o=rx \) -o \( -type f ! -perm -o=r \) | head -n 5)"
    [[ -z "$unreadable" ]] ||
      die "the release directory must be readable by the paddock-api service (uid 65532): run 'chmod -R a+rX $release_dir' — not readable: $(printf '%s' "$unreadable" | tr '\n' ' ')"
    # shellcheck disable=SC2046
    compose run --rm --no-deps $(tty_flag) -v "$release_dir:/release:ro" paddock-api \
      admin agent-release --version "$1" --dir /release
    ;;
  agent-rollout | agent-rollout-halt | agent-rollout-resume)
    # Host operator exception from the portal's sign-in and step-up (ADR 0034 amendment 2026-10-26, RR-90).
    if [[ "$cmd" == agent-rollout ]]; then
      [[ $# -ge 1 && "$1" != -* ]] || die "usage: ./paddock agent-rollout <version> [--waves 1,10,50,100] [--min-wave-minutes N] [--failure-threshold-percent P] [--failure-threshold-min M]" 2
    else
      [[ $# -eq 1 && "$1" != -* ]] || die "usage: ./paddock $cmd <version>" 2
    fi
    require_host controlplane lab "$cmd"
    version="$1"
    shift
    # shellcheck disable=SC2046
    compose run --rm --no-deps $(tty_flag) paddock-api admin "$cmd" --version "$version" "$@"
    ;;
  restore)
    # Plan M15 decisions 23–24: the steps live in restore.sh, which restore-drill.sh shares.
    require_host controlplane lab "restore"
    lab_warning
    # shellcheck source=../compose/scripts/restore.sh
    . "$BUNDLE_DIR/scripts/restore.sh"
    restore_main "$@"
    ;;
  rollback)
    # shellcheck source=../compose/scripts/rollback.sh
    . "$BUNDLE_DIR/scripts/rollback.sh"
    # shellcheck source=../compose/scripts/legacy-alpha8.sh
    . "$BUNDLE_DIR/scripts/legacy-alpha8.sh"
    # shellcheck source=../compose/scripts/openbao-restore.sh
    . "$BUNDLE_DIR/scripts/openbao-restore.sh"
    rollback_main "$BUNDLE_DIR" "$@"
    ;;
  auto-unseal)
    # Automatic unseal of OpenBao (ADR 0035, plan M8u decision 18). A share is never printed, logged or put on a
    # command line: it is read from stdin and written to its file only.
    shares_file="$SECRETS_DIR/openbao/auto-unseal-shares"
    case "${1:-}" in
      status)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        echo "PADDOCK_AUTO_UNSEAL=$(dotenv PADDOCK_AUTO_UNSEAL)"
        if [[ -e "$shares_file" ]]; then echo "shares file: present"; else echo "shares file: absent"; fi
        line="$(PADDOCK_AUTO_UNSEAL=yes compose --profile paddock ps --format '{{.Name}} {{.Status}}' paddock-unsealer 2>/dev/null || true)"
        echo "paddock-unsealer: ${line:-not running}"
        sealed="$(compose exec -T -e BAO_ADDR=https://127.0.0.1:8200 -e BAO_CACERT=/run/secrets/internal_ca_bundle \
          openbao bao status 2>/dev/null | grep '^Sealed' || true)"
        echo "${sealed:-Sealed          unknown (OpenBao did not answer)}"
        ;;
      enable)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        require_host controlplane lab "auto-unseal enable"
        lab_warning
        [[ "$(dotenv PADDOCK_AUTO_UNSEAL)" != yes && ! -e "$shares_file" ]] ||
          die "automatic unseal is already set up on this host: run ./paddock auto-unseal disable first"
        "$BUNDLE_DIR/scripts/gen-prod-secrets.sh" "$PADDOCK_HOST" >/dev/null </dev/null
        # The portal acknowledgement first: no share reaches the host without it.
        # stdin stays for the shares: no command before them may read it.
        if ! verified="$(compose run --rm --no-deps -T paddock-worker admin auto-unseal verify 2>/dev/null </dev/null)"; then
          die "$(grep -m1 '^automatic unseal' <<<"$verified" || echo 'automatic unseal is not enabled: a platform administrator enables it in the portal first (Platform → OpenBao)')"
        fi
        grep -m1 '^automatic unseal' <<<"$verified" || true
        "$BUNDLE_DIR/scripts/postgres-unsealer-role.sh" </dev/null
        shares=()
        for n in 1 2 3; do
          share=""
          IFS= read -rs -p "Unseal share $n of 3 (from a custodian, not echoed): " share || true
          [[ ! -t 0 ]] || echo >&2
          [[ -n "$share" ]] || die "share $n is empty"
          [[ ! "$share" =~ [[:space:]] ]] || die "share $n contains whitespace"
          for s in "${shares[@]}"; do
            [[ "$s" != "$share" ]] || die "share $n equals an earlier share: three different custodians' shares are needed"
          done
          shares+=("$share")
        done
        mkdir -p "$SECRETS_DIR/openbao"
        chmod 700 "$SECRETS_DIR" "$SECRETS_DIR/openbao"
        tmp="$(umask 077 && mktemp "$SECRETS_DIR/openbao/.auto-unseal-shares.XXXXXX")"
        printf '%s\n' "${shares[@]}" >"$tmp"
        unset shares share s
        mv "$tmp" "$shares_file"
        # Readable by the unsealer's user (65532) through the Compose secret; the 0700 directory protects it.
        chmod 644 "$shares_file"
        set_dotenv PADDOCK_AUTO_UNSEAL yes
        compose --profile paddock up -d paddock-unsealer
        echo "automatic unseal is enabled on this host. Verify it now: ./paddock compose restart openbao, then ./paddock bao status shows \"Sealed false\" within 30 s. Remove every other unseal automation (for example a cron job) and its copies of the shares."
        ;;
      disable)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        require_host controlplane lab "auto-unseal disable"
        # With the overlay forced into the file set, so that an unsealer left running is found whatever .env says.
        PADDOCK_AUTO_UNSEAL=yes compose --profile paddock stop paddock-unsealer >/dev/null 2>&1 || true
        PADDOCK_AUTO_UNSEAL=yes compose --profile paddock rm -f paddock-unsealer >/dev/null 2>&1 || true
        if [[ -e "$shares_file" ]]; then
          if command -v shred >/dev/null; then shred -u "$shares_file"; else rm -f "$shares_file"; fi
        fi
        set_dotenv PADDOCK_AUTO_UNSEAL no
        echo "the shares are deleted from this host. If the host, its disk or its backups may have been copied while automatic unseal was on, rotate the shares with three custodians (docs/operations/openbao.md section 6). If the portal still shows automatic unseal as enabled, a platform administrator disables it there."
        ;;
      *) die "usage: ./paddock auto-unseal status|enable|disable" 2 ;;
    esac
    ;;
  backup)
    # The host's emergency path without the portal (plan M15 decision 21, ADR 0046 decision 9).
    case "${1:-}" in
      now | status) ;;
      *) die "usage: ./paddock backup now [--kind k]... [--label l] [--wait] | ./paddock backup status" 2 ;;
    esac
    require_backup_host "backup $1"
    # shellcheck disable=SC2046
    backup_role $(tty_flag) paddock-backup backup "$@"
    ;;
  backup-target)
    # Mounts the local, SMB and NFS targets of the database as Docker volumes of paddock-backup (plan M15 decision 20,
    # decisions-alpha9 items 35 and 36). The render holds the decrypted SMB passwords: it travels on a pipe into this
    # process and into the 0600 file only, never onto a command line or into the output. Pipes instead of here-strings:
    # bash spills a here-string above 64 KiB into a temp file in $TMPDIR.
    if [[ "${1:-}" == export ]]; then
      require_host controlplane lab "backup-target"
      shift
      # shellcheck source=../compose/scripts/restore.sh
      . "$BUNDLE_DIR/scripts/restore.sh"
      restore_target_export "$@"
      exit 0
    fi
    [[ "${1:-}" == apply && $# -eq 1 ]] ||
      die "usage: ./paddock backup-target apply | ./paddock backup-target export <name|id> <file>" 2
    require_backup_host "backup-target apply"
    uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
    root="$(dotenv PADDOCK_BACKUP_LOCAL_ROOT)"
    render="$(backup_role -T paddock-backup admin backup-targets render ${root:+--local-root "$root"} </dev/null)" ||
      die "backup-target apply: the targets could not be rendered (see above); nothing changed"
    doc="" marks=() keep=() deleted=() names=()
    while read -r kind a b c d; do
      case "$kind" in
        compose) doc="$a" ;;
        mount)
          [[ "$a" =~ $uuid_re && "$b" =~ ^[1-9][0-9]*$ && "$d" =~ ^backup-target-$a-r$b-[0-9a-f]{12}$ ]] ||
            die "backup-target apply: unexpected render line"
          marks+=("$a" "$b")
          keep+=("${PADDOCK_PROJECT}_$d")
          names+=("$(printf '%s' "$c" | base64 -d)")
          ;;
        deleted)
          [[ "$a" =~ $uuid_re ]] || die "backup-target apply: unexpected render line"
          deleted+=("$a")
          ;;
        "") ;;
        *) die "backup-target apply: unexpected render line" ;;
      esac
    done < <(printf '%s\n' "$render")
    unset render
    if [[ -n "$doc" ]]; then
      # The new file is tried first: the one-off container mounts every volume and writes each marker. A share that
      # does not mount leaves the running configuration untouched, so ./paddock up never meets it.
      tmp="$(umask 077 && mktemp --suffix=.yaml "$BUNDLE_DIR/.compose.backup-targets.XXXXXX")"
      trap 'rm -f "$tmp"' EXIT
      printf '%s' "$doc" | base64 -d >"$tmp"
      unset doc
      resolve_local_targets "$tmp" ||
        die "backup-target apply: a local target does not resolve below PADDOCK_BACKUP_LOCAL_ROOT (see above); nothing changed"
      BACKUP_TARGETS_OVERLAY="$tmp" run_redacted compose --profile paddock run --rm --no-deps -T paddock-backup \
        backup mark-mount "${marks[@]}" </dev/null >/dev/null ||
        die "backup-target apply: a target could not be mounted (see above); nothing changed"
      chmod 600 "$tmp"
      mv "$tmp" "$BACKUP_TARGETS_FILE"
      trap - EXIT
      echo "rendered $BACKUP_TARGETS_FILE (mode 0600; it holds the share passwords: never copy, commit or print it)"
      printf 'target: %s\n' "${names[@]}"
    else
      rm -f "$BACKUP_TARGETS_FILE"
      echo "no local, SMB or NFS target in the database; $BACKUP_TARGETS_FILE removed"
    fi
    # Volumes of earlier revisions and of deleted targets go once paddock-backup no longer uses them.
    in_use=()
    while IFS= read -r vol; do
      [[ "$vol" == "${PADDOCK_PROJECT}_backup-target-"* ]] || continue
      [[ " ${keep[*]} " != *" $vol "* ]] || continue
      if docker volume rm "$vol" </dev/null >/dev/null 2>&1; then echo "removed volume $vol"; else in_use+=("$vol"); fi
    done < <(docker volume ls -q --filter "label=com.docker.compose.project=$PADDOCK_PROJECT")
    gone=()
    for id in "${deleted[@]}"; do
      [[ " ${in_use[*]} " == *"_backup-target-$id-r"* ]] || gone+=("$id")
    done
    if ((${#gone[@]})); then
      backup_role -T paddock-backup admin backup-targets purge "${gone[@]}" </dev/null ||
        die "backup-target apply: the deleted targets' rows could not be removed; run ./paddock backup-target apply again"
    fi
    echo "next: ./paddock up (recreates paddock-backup with these targets; the portal shows them mounted within a minute)"
    if ((${#in_use[@]})); then
      echo "after ./paddock up run ./paddock backup-target apply again to remove the volumes still in use: ${in_use[*]}"
    fi
    ;;
esac
