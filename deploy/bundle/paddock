#!/usr/bin/env bash
# Entry point of the operator bundle (plan M7b decision 16, ADR 0022): every operation of a production host, with the
# Compose files of PADDOCK_HOST and the project PADDOCK_PROJECT of .env. Never prints a secret.
set -euo pipefail

BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat >&2 <<'EOF'
usage: ./paddock <command> [arguments]
  version                         print the bundle version
  verify                          check the shipped files against SHA256SUMS
  secrets                         generate this host's secrets into .secrets/ (idempotent)
  pull                            pull every image of this host
  check [--online]                production checklist (prod-check) of this host's configuration
  up [--infra]                    start the stack and wait until healthy (--infra: infrastructure only)
  down [--volumes]                stop the stack (--volumes also deletes the data)
  ps                              list the services
  logs [service...]               show the last log lines
  compose <args...>               docker compose with this host's files
  bao <args...>                   the bao CLI inside the openbao container (BAO_TOKEN from the environment)
  bootstrap openbao|buckets|audit-bucket|fleet
                                  configure OpenBao, the buckets or Fleet (docs/operations/install.md)
  agent-release <version> <dir>   upload and publish signed agent artifacts (control plane)
  auto-unseal status|enable|disable
                                  automatic unseal of OpenBao on this host (docs/operations/openbao.md section 6)
  migrate-from <old dir>          take over .env and .secrets/ of the bundle directory of the running version
EOF
  exit 2
}

die() {
  echo "paddock: $1" >&2
  exit "${2:-1}"
}

cmd="${1:-}"
(($#)) && shift
case "$cmd" in
  version)
    cat "$BUNDLE_DIR/VERSION"
    exit 0
    ;;
  verify)
    cd "$BUNDLE_DIR"
    sha256sum -c --quiet SHA256SUMS
    echo "all shipped files unchanged"
    exit 0
    ;;
  migrate-from)
    old="${1:-}"
    [[ $# -eq 1 && -d "$old" ]] || die "usage: ./paddock migrate-from <old bundle directory>" 2
    old="$(cd "$old" && pwd)"
    [[ "$old" != "$BUNDLE_DIR" ]] || die "migrate-from: <old dir> is this directory" 2
    [[ ! -e "$BUNDLE_DIR/.env" ]] || die "migrate-from: .env exists here; refusing to overwrite it"
    [[ ! -e "$BUNDLE_DIR/.secrets" ]] || die "migrate-from: .secrets/ exists here; refusing to overwrite it"
    [[ -f "$old/.env" && -d "$old/.secrets" ]] || die "migrate-from: $old has no .env and .secrets/"
    cp -a "$old/.env" "$BUNDLE_DIR/.env"
    cp -a "$old/.secrets" "$BUNDLE_DIR/.secrets"
    echo "copied .env and .secrets/ from $old"
    exit 0
    ;;
  secrets | pull | check | up | down | ps | logs | compose | bao | bootstrap | agent-release | auto-unseal) ;;
  *) usage ;;
esac

# dotenv <name>: the value in .env only; the process environment does not count for the host settings.
dotenv() { grep "^$1=" "$BUNDLE_DIR/.env" | tail -1 | cut -d= -f2- || true; }
[[ -f "$BUNDLE_DIR/.env" ]] || die "missing .env: cp .env.example .env (a lab host: cp .env.lab.example .env), then set PADDOCK_HOST and the settings of this host" 2
[[ "$(dotenv PADDOCK_ENV)" == production ]] || die "PADDOCK_ENV in .env must be production (the bundle is for production hosts)" 2
PADDOCK_HOST="$(dotenv PADDOCK_HOST)"
[[ "$PADDOCK_HOST" == controlplane || "$PADDOCK_HOST" == audit || "$PADDOCK_HOST" == lab ]] ||
  die "set PADDOCK_HOST to controlplane, audit or lab in .env (is '${PADDOCK_HOST}')" 2
PADDOCK_ENV=production
export PADDOCK_ENV PADDOCK_HOST

# shellcheck source=../compose/scripts/lib.sh
. "$BUNDLE_DIR/scripts/lib.sh"

# tty_flag prints -T unless stdin and stdout are terminals, so that piped and redirected output stays plain.
tty_flag() { [[ -t 0 && -t 1 ]] || printf -- '-T'; }

# require_host <host> lab <command>: the command runs on that host, or on a lab host, which holds both (ADR 0029).
require_host() {
  [[ "$PADDOCK_HOST" == "$1" || "$PADDOCK_HOST" == "$2" ]] || die "$3 runs on the $1 host (PADDOCK_HOST is $PADDOCK_HOST)" 2
}

# set_dotenv <name> <value>: replaces the line name=… of .env, or appends it; keeps the file's mode.
set_dotenv() {
  local name="$1" value="$2" env="$BUNDLE_DIR/.env" tmp
  tmp="$(mktemp "$BUNDLE_DIR/.env.XXXXXX")"
  if grep -q "^${name}=" "$env"; then
    sed "s|^${name}=.*|${name}=${value}|" "$env" >"$tmp"
  else
    cat "$env" >"$tmp"
    [[ -z "$(tail -c 1 "$env")" ]] || echo >>"$tmp"
    printf '%s=%s\n' "$name" "$value" >>"$tmp"
  fi
  chmod --reference="$env" "$tmp"
  mv "$tmp" "$env"
}

# lab_warning prints the lab profile's warning as the command's first output line.
lab_warning() {
  [[ "$PADDOCK_HOST" != lab ]] ||
    echo "lab profile (PADDOCK_HOST=lab): not for production — see docs/operations/lab-install.md" >&2
}

case "$cmd" in
  secrets)
    exec "$BUNDLE_DIR/scripts/gen-prod-secrets.sh" "$PADDOCK_HOST"
    ;;
  pull)
    compose --profile '*' pull "$@"
    ;;
  check)
    online=
    case "${1:-}" in
      "") ;;
      --online) online=1 ;;
      *) die "usage: ./paddock check [--online]" 2 ;;
    esac
    lab_warning
    # The check reads the production configuration exactly as shipped: no extra Compose files (the CI overlay).
    files="$(PADDOCK_COMPOSE_EXTRA='' compose_files)"
    names="$(xargs -n1 basename <<<"$files" | paste -sd, -)"
    # The configuration names host paths (secret files, mounted files), hence the bundle directory at its own path;
    # root, because .secrets/ is the operator's 0700 directory and the image's default user is 65532.
    PADDOCK_COMPOSE_EXTRA='' compose --profile '*' config --format json |
      docker run --rm -i --user 0:0 ${online:+--network "${PADDOCK_PROJECT}_audit-store"} \
        -v "$BUNDLE_DIR:$BUNDLE_DIR:ro" -w "$BUNDLE_DIR" "$PADDOCK_IMAGE" \
        prod-check --host "$PADDOCK_HOST" --compose-files "$names" ${online:+--online}
    ;;
  up)
    profiles=(--profile paddock --profile observability)
    case "${1:-}" in
      "") ;;
      --infra) profiles=() ;;
      *) die "usage: ./paddock up [--infra]" 2 ;;
    esac
    lab_warning
    if [[ "$PADDOCK_HOST" != audit && "$(uname -m)" != x86_64 ]]; then
      die "the control plane needs an amd64 host: the Fleet image (fleetdm/fleet) is published for linux/amd64 only"
    fi
    compose "${profiles[@]}" up -d
    "$BUNDLE_DIR/scripts/wait-healthy.sh" "${profiles[@]}"
    ;;
  down)
    case "${1:-}" in
      "") compose --profile paddock --profile observability down ;;
      --volumes) compose --profile paddock --profile observability down -v ;;
      *) die "usage: ./paddock down [--volumes]" 2 ;;
    esac
    ;;
  ps)
    compose --profile '*' ps "$@"
    ;;
  logs)
    compose --profile '*' logs --no-color --tail 300 "$@"
    ;;
  compose)
    compose "$@"
    ;;
  bao)
    # shellcheck disable=SC2046
    compose exec $(tty_flag) -e BAO_ADDR=https://127.0.0.1:8200 -e BAO_CACERT=/run/secrets/internal_ca_bundle \
      ${BAO_TOKEN:+-e BAO_TOKEN} openbao bao "$@"
    ;;
  bootstrap)
    case "${1:-}" in
      openbao)
        require_host controlplane lab "bootstrap openbao"
        "$BUNDLE_DIR/scripts/openbao-configure.sh"
        ;;
      buckets)
        require_host controlplane lab "bootstrap buckets"
        "$BUNDLE_DIR/scripts/rustfs-bundles-bootstrap.sh"
        ;;
      audit-bucket)
        require_host audit lab "bootstrap audit-bucket"
        "$BUNDLE_DIR/scripts/rustfs-audit-bootstrap.sh"
        ;;
      fleet)
        require_host controlplane lab "bootstrap fleet"
        "$BUNDLE_DIR/scripts/fleet-bootstrap.sh"
        ;;
      *) die "usage: ./paddock bootstrap openbao|buckets|audit-bucket|fleet" 2 ;;
    esac
    ;;
  agent-release)
    [[ $# -eq 2 && -d "$2" ]] || die "usage: ./paddock agent-release <version> <dir>" 2
    require_host controlplane lab "agent-release"
    release_dir="$(cd "$2" && pwd)"
    # paddock-api runs as uid 65532 and reads the directory through a read-only bind mount (plan M8x decision 50).
    unreadable="$(find "$release_dir" \( -type d ! -perm -o=rx \) -o \( -type f ! -perm -o=r \) | head -n 5)"
    [[ -z "$unreadable" ]] ||
      die "the release directory must be readable by the paddock-api service (uid 65532): run 'chmod -R a+rX $release_dir' — not readable: $(printf '%s' "$unreadable" | tr '\n' ' ')"
    # shellcheck disable=SC2046
    compose run --rm --no-deps $(tty_flag) -v "$release_dir:/release:ro" paddock-api \
      admin agent-release --version "$1" --dir /release
    ;;
  auto-unseal)
    # Automatic unseal of OpenBao (ADR 0035, plan M8u decision 18). A share is never printed, logged or put on a
    # command line: it is read from stdin and written to its file only.
    shares_file="$SECRETS_DIR/openbao/auto-unseal-shares"
    case "${1:-}" in
      status)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        echo "PADDOCK_AUTO_UNSEAL=$(dotenv PADDOCK_AUTO_UNSEAL)"
        if [[ -e "$shares_file" ]]; then echo "shares file: present"; else echo "shares file: absent"; fi
        line="$(PADDOCK_AUTO_UNSEAL=yes compose --profile paddock ps --format '{{.Name}} {{.Status}}' paddock-unsealer 2>/dev/null || true)"
        echo "paddock-unsealer: ${line:-not running}"
        sealed="$(compose exec -T -e BAO_ADDR=https://127.0.0.1:8200 -e BAO_CACERT=/run/secrets/internal_ca_bundle \
          openbao bao status 2>/dev/null | grep '^Sealed' || true)"
        echo "${sealed:-Sealed          unknown (OpenBao did not answer)}"
        ;;
      enable)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        require_host controlplane lab "auto-unseal enable"
        lab_warning
        [[ "$(dotenv PADDOCK_AUTO_UNSEAL)" != yes && ! -e "$shares_file" ]] ||
          die "automatic unseal is already set up on this host: run ./paddock auto-unseal disable first"
        "$BUNDLE_DIR/scripts/gen-prod-secrets.sh" "$PADDOCK_HOST" >/dev/null </dev/null
        # The portal acknowledgement first: no share reaches the host without it.
        # stdin stays for the shares: no command before them may read it.
        if ! verified="$(compose run --rm --no-deps -T paddock-worker admin auto-unseal verify 2>/dev/null </dev/null)"; then
          die "$(grep -m1 '^automatic unseal' <<<"$verified" || echo 'automatic unseal is not enabled: a platform administrator enables it in the portal first (Platform → OpenBao)')"
        fi
        grep -m1 '^automatic unseal' <<<"$verified" || true
        "$BUNDLE_DIR/scripts/postgres-unsealer-role.sh" </dev/null
        shares=()
        for n in 1 2 3; do
          share=""
          IFS= read -rs -p "Unseal share $n of 3 (from a custodian, not echoed): " share || true
          [[ ! -t 0 ]] || echo >&2
          [[ -n "$share" ]] || die "share $n is empty"
          [[ ! "$share" =~ [[:space:]] ]] || die "share $n contains whitespace"
          for s in "${shares[@]}"; do
            [[ "$s" != "$share" ]] || die "share $n equals an earlier share: three different custodians' shares are needed"
          done
          shares+=("$share")
        done
        mkdir -p "$SECRETS_DIR/openbao"
        chmod 700 "$SECRETS_DIR" "$SECRETS_DIR/openbao"
        tmp="$(umask 077 && mktemp "$SECRETS_DIR/openbao/.auto-unseal-shares.XXXXXX")"
        printf '%s\n' "${shares[@]}" >"$tmp"
        unset shares share s
        mv "$tmp" "$shares_file"
        # Readable by the unsealer's user (65532) through the Compose secret; the 0700 directory protects it.
        chmod 644 "$shares_file"
        set_dotenv PADDOCK_AUTO_UNSEAL yes
        compose --profile paddock up -d paddock-unsealer
        echo "automatic unseal is enabled on this host. Verify it now: ./paddock compose restart openbao, then ./paddock bao status shows \"Sealed false\" within 30 s. Remove every other unseal automation (for example a cron job) and its copies of the shares."
        ;;
      disable)
        [[ $# -eq 1 ]] || die "usage: ./paddock auto-unseal status|enable|disable" 2
        require_host controlplane lab "auto-unseal disable"
        # With the overlay forced into the file set, so that an unsealer left running is found whatever .env says.
        PADDOCK_AUTO_UNSEAL=yes compose --profile paddock stop paddock-unsealer >/dev/null 2>&1 || true
        PADDOCK_AUTO_UNSEAL=yes compose --profile paddock rm -f paddock-unsealer >/dev/null 2>&1 || true
        if [[ -e "$shares_file" ]]; then
          if command -v shred >/dev/null; then shred -u "$shares_file"; else rm -f "$shares_file"; fi
        fi
        set_dotenv PADDOCK_AUTO_UNSEAL no
        echo "the shares are deleted from this host. If the host, its disk or its backups may have been copied while automatic unseal was on, rotate the shares with three custodians (docs/operations/openbao.md section 6). If the portal still shows automatic unseal as enabled, a platform administrator disables it there."
        ;;
      *) die "usage: ./paddock auto-unseal status|enable|disable" 2 ;;
    esac
    ;;
esac
