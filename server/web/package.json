{
  "name": "paddock-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi/admin.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch dist/.gitkeep",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && node scripts/check-audit-messages.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "intl-messageformat": "12.1.2",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1",
    "vuetify": "4.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
