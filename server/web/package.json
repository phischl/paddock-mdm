{
  "name": "paddock-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi/admin.yaml -o src/api/schema.d.ts",
    "dev": "node scripts/copy-logos.ts && vite",
    "build": "node scripts/copy-logos.ts && vue-tsc --noEmit && vite build && touch dist/.gitkeep",
    "typecheck": "vue-tsc --noEmit",
    "gen:icons": "node scripts/gen-icons.ts",
    "lint": "eslint . && node scripts/check-messages.ts && node scripts/check-vendored.ts && node scripts/gen-icons.ts --check",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "intl-messageformat": "12.2.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23",
    "vue-router": "5.5.1",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
