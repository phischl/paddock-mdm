# German translation of Paddock Self-Service. Compiled by selfservice/tools/msgfmt.py at package build time;
# selfservice/tests/test_i18n.py checks that every source string has a translation here.
msgid ""
msgstr ""
"Project-Id-Version: paddock-self-service\n"
"Language: de\n"
"MIME-Version: 1.0\n"
