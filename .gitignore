# Secrets generated for local development
deploy/compose/.secrets/
deploy/compose/restore-staging/
deploy/compose/bundle-seq/
deploy/compose/.env

# Build output
/paddock-server
/bin/
/dist/
server/web/dist/*
!server/web/dist/.gitkeep
# Logos copied from docs/assets/logo/ at build time
server/web/public/paddock-*.svg
node_modules/
*.out
coverage.*

# Playwright
server/web/test-results/
server/web/playwright-report/
# A link to the VM secrets of another worktree (a directory pattern does not match a symlink).
test/vms/virtualbox/.secrets

# Rendered by ./paddock backup-target apply on a host (plan M15 decision 20): holds share passwords.
deploy/compose/compose.backup-targets.yaml
deploy/compose/.compose.backup-targets.*

# Python bytecode of the self-service app (selfservice/)
__pycache__/
